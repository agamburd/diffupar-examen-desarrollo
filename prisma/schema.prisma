// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // <-- Cambiado a MySQL
  url      = env("DATABASE_URL")
}

model Orders {
  id           Int       @id @default(autoincrement())
  orderId      String    @db.VarChar(25)
  source       String    @db.VarChar(25)
  bridgeId     String?   @db.VarChar(25)
  storeId      String    @db.VarChar(5)
  status       String?   @db.VarChar(25)
  napseStatus  String?   @db.VarChar(15)
  lastUpdated  DateTime?
  creationDate String?   @db.VarChar(50)

  @@unique([orderId, storeId, source])
}